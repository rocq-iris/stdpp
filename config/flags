# Specification for custom Rocq compilation flags (turns into `-arg` values in `_RocqProject`).
# Syntax:
# - One flag per line with no leading/trailing blanks.
# - Empty lines and lines starting with '#' are ignored.

# Needs Stdlib 9.1.
-w
-deprecated-reference-since-9.1

# Needs Rocq 9.2.
-w
-notation-for-abbreviation

# Needs Rocq 9.2.
-w
-implicit-create-rewrite-hint-db

# The ltac_expr case of this is very annoying to deal with so we are hoping for
# better alternatives (https://github.com/rocq-prover/rocq/issues/21896).
-w
-level-tolerance

# Need Rocq 9.3 for the rw tactic.
-w
-rewrite-rw

# Overwrite some default Rocq options
-set
'Default Goal Selector=!'
-set
'Default Proof Using=Type'
# FIXME: cannot enable this yet as some files disable 'Default Proof Using'
#-set
#'Suggest Proof Using'
